{
    "name": "aubes/csp-bundle",
    "type": "symfony-bundle",
    "description": "Symfony bundle for Content-Security-Policy headers management with multi-group policies, nonces, hashes and reporting",
    "keywords": ["symfony", "bundle", "csp", "content-security-policy", "security", "nonce"],
    "license": "MIT",
    "authors": [
        {
            "name": "Aurélian Bes"
        }
    ],
    "support": {
        "issues": "https://github.com/aubes/csp-bundle/issues",
        "source": "https://github.com/aubes/csp-bundle"
    },
    "require": {
        "php": ">=8.2",
        "psr/log": "^2.0 | ^3.0",
        "symfony/framework-bundle": "^6.4 | ^7.4 | ^8.0",
        "symfony/http-foundation": "^6.4 | ^7.4 | ^8.0",
        "symfony/http-kernel": "^6.4 | ^7.4 | ^8.0",
        "symfony/routing": "^6.4 | ^7.4 | ^8.0"
    },
    "suggest": {
        "symfony/twig-bundle": "Required for Twig nonce/hash helpers (csp_nonce, csp_hash)"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.1",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0",
        "symfony/twig-bundle": "^6.4 | ^7.4 | ^8.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": { "Aubes\\CSPBundle\\": "src" },
        "exclude-from-classmap": [
            "/tests"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Aubes\\CSPBundle\\Tests\\": "tests"
        }
    },
    "scripts": {
        "analyse": [
            "@cs",
            "@phpstan"
        ],
        "cs": "php-cs-fixer fix --allow-risky=yes --config=.php-cs-fixer.php --dry-run --verbose",
        "fix-cs": "php-cs-fixer fix --allow-risky=yes --config=.php-cs-fixer.php --show-progress=dots --verbose",
        "phpstan": "phpstan analyse",
        "test": "phpunit tests"
    }
}
